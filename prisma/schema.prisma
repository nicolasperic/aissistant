generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalType {
  YEARLY
  QUARTERLY
  MONTHLY
  WEEKLY
}

enum TaskStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  shortName   String?
  description String?
  type        GoalType
  startDate   DateTime
  endDate     DateTime
  progress    Float     @default(0)
  parentId    String?
  parent      Goal?     @relation("GoalHierarchy", fields: [parentId], references: [id])
  children    Goal[]    @relation("GoalHierarchy")
  tasks       Task[]
  events      Event[]
  category    String?
  notes       String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id               String       @id @default(cuid())
  title            String
  description      String?
  planningNotes    String?
  status           TaskStatus   @default(PENDING)
  priority         TaskPriority @default(MEDIUM)
  scheduledDate    DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  goalId           String?
  goal             Goal?        @relation(fields: [goalId], references: [id])
  studyNote        StudyNote?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model StudyNote {
  id               String      @id @default(cuid())
  title            String
  content          String
  certCode         String?
  taskId           String?     @unique
  task             Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goalId           String?
  bookmarkPosition String?
  validated        Boolean     @default(false)
  position         Int         @default(0)
  flashcards       Flashcard[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  category    String?
  url         String?
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyReview {
  id                String   @id @default(cuid())
  weekStart         DateTime
  weekEnd           DateTime
  rating            Int?
  completedTasks    Int      @default(0)
  totalTasks        Int      @default(0)
  studyMinutes      Int      @default(0)
  userNotes         String?
  aiAnalysis              String?
  aiRecommendations       String?
  aiHighlights            String?
  aiAreasForImprovement   String?
  createdAt               DateTime @default(now())
}

model ProgressSnapshot {
  id        String   @id @default(cuid())
  date      DateTime
  goalId    String
  progress  Float
  createdAt DateTime @default(now())
}

model Reward {
  id          String   @id @default(cuid())
  type        String
  name        String
  description String?
  icon        String?
  earnedAt    DateTime @default(now())
  metadata    Json?
}

model UserStats {
  id                    String    @id @default("singleton")
  totalPoints           Int       @default(0)
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActiveDate        DateTime?
  completedTourSteps    String[]  @default([])
  onboardingCompleted   Boolean   @default(false)
  updatedAt             DateTime  @updatedAt
}

// ─── User Certification Status ────────────────────────────────────────────────

enum UserCertStatus {
  PASSED
  PREPARING
  NOT_INTERESTED
}

model UserCertification {
  id          String         @id @default(cuid())
  certCode    String         @unique
  status      UserCertStatus
  passedAt    DateTime?
  examDate    DateTime?
  goalId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AiContext {
  id        String   @id @default(cuid())
  type      String
  prompt    String
  response  String
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── Practice Tests ───────────────────────────────────────────────────────────

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum QuestionSource {
  OFFICIAL
  AI_GENERATED
}

enum PracticeTestType {
  OFFICIAL
  AI_GENERATED
  SHUFFLE
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Certification {
  id               String         @id @default(cuid())
  name             String
  code             String
  provider         String
  description      String?
  totalQuestions   Int
  passingScore     Int
  timeLimitMinutes Int
  sections         CertSection[]
  questions        Question[]
  practiceTests    PracticeTest[]
  createdAt        DateTime       @default(now())
}

model CertSection {
  id              String        @id @default(cuid())
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  name            String
  percentage      Int
  questions       Question[]
}

model Question {
  id              String               @id @default(cuid())
  certificationId String
  certification   Certification        @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certSectionId   String?
  certSection     CertSection?         @relation(fields: [certSectionId], references: [id], onDelete: SetNull)
  text            String
  type            QuestionType
  explanation     String?
  source          QuestionSource
  options         QuestionOption[]
  testLinks       PracticeTestQuestion[]
  attemptQuestions AttemptQuestion[]
  attemptAnswers  AttemptAnswer[]
  createdAt       DateTime             @default(now())
}

model QuestionOption {
  id                    String                @id @default(cuid())
  questionId            String
  question              Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text                  String
  isCorrect             Boolean
  attemptQuestionOptions AttemptQuestionOption[]
  attemptAnswerOptions  AttemptAnswerOption[]
}

model PracticeTest {
  id              String                 @id @default(cuid())
  certificationId String
  certification   Certification          @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  title           String
  type            PracticeTestType
  questionCount   Int
  questionLinks   PracticeTestQuestion[]
  attempts        ExamAttempt[]
  createdAt       DateTime               @default(now())
}

model PracticeTestQuestion {
  practiceTestId String
  practiceTest   PracticeTest @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position       Int

  @@id([practiceTestId, questionId])
}

model ExamAttempt {
  id              String            @id @default(cuid())
  practiceTestId  String
  practiceTest    PracticeTest      @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  score           Int?
  totalQuestions  Int
  passed          Boolean?
  status          AttemptStatus     @default(IN_PROGRESS)
  questions       AttemptQuestion[]
  answers         AttemptAnswer[]
}

model AttemptQuestion {
  id         String                  @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  options    AttemptQuestionOption[]

  @@unique([attemptId, questionId])
}

model AttemptQuestionOption {
  id                String          @id @default(cuid())
  attemptQuestionId String
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  optionId          String
  option            QuestionOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  position          Int
}

model AttemptAnswer {
  id         String                @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  flagged    Boolean               @default(false)
  isCorrect  Boolean?
  selected   AttemptAnswerOption[]

  @@unique([attemptId, questionId])
}

model AttemptAnswerOption {
  answerId String
  answer   AttemptAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId String
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
}

// ─────────────────────────────────────────────────────────────────────────────

enum CardRating {
  EASY
  MEDIUM
  HARD
  MISSED
}

model Flashcard {
  id             String      @id @default(cuid())
  question       String
  answer         String
  hint           String?
  topic          String
  examCode       String?
  goalId         String?
  studyNoteId    String?
  studyNote      StudyNote?  @relation(fields: [studyNoteId], references: [id], onDelete: SetNull)
  correctCount   Int         @default(0)
  incorrectCount Int         @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  lastRating     CardRating?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
